# Copy to apps/<app>/.env.local (Vite reads VITE_* variables at build time).
# These values are public by design: they ship to the browser.

# TOGIVA Core API base URL (no trailing slash). The API must list this app's
# origin in CORS_ALLOWED_ORIGINS.
VITE_TOGIVA_API_URL=http://localhost:4000

# Organization slug of the Mr. Cow organization record in TOGIVA Core.
# Must match the slug created during onboarding.
VITE_TOGIVA_ORGANIZATION_SLUG=mr-cow

# Supabase Auth project (identity only). Use the project URL and the public
# anon/publishable key, never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development only: lets you paste a bearer token instead of signing in through
# Supabase (useful against a local TOGIVA Core). Ignored in production builds.
VITE_DEV_TOKEN_SIGN_IN=false
